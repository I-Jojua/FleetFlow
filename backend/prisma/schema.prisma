generator client {
provider = "prisma-client"
output   = "../src/generated/prisma"
}

datasource db {
provider = "postgresql"
}

enum UserRole {
SUPER_ADMIN
ADMIN
DISPATCHER
DRIVER
CUSTOMER
}

enum UserStatus {
ACTIVE
INACTIVE
SUSPENDED
PENDING_VERIFICATION
}

enum DriverAvailability {
  AVAILABLE
  UNAVAILABLE
  ON_BREAK
  OFF_DUTY
  SUSPENDED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
  TRUCK
  REFRIGERATED_TRUCK
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum QualificationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DriverShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
PENDING
ASSIGNED
PICKED_UP
IN_TRANSIT
DELIVERED
CANCELLED
}


enum NotificationType {
  DELIVERY_UPDATE
  SYSTEM
  ACCOUNT
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum OutboxEventType {
  AUTH_EMAIL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
model User {
id           String     @id @default(uuid()) @db.Uuid
firstName    String     @map("first_name") @db.VarChar(100)
lastName     String     @map("last_name") @db.VarChar(100)
email        String     @unique @db.VarChar(255)
passwordHash String     @map("password_hash") @db.VarChar(255)
phone        String?    @unique @db.VarChar(30)
role         UserRole   @default(CUSTOMER)
status       UserStatus @default(ACTIVE)
availability DriverAvailability @default(AVAILABLE) @map("availability")

emailVerifiedAt DateTime? @map("email_verified_at")
lastLoginAt     DateTime? @map("last_login_at")

refreshTokens RefreshToken[]
authTokens    AuthToken[]
auditLogs     AuditLog[]
idempotencyRecords IdempotencyRecord[]

customerDeliveries Delivery[] @relation("CustomerDeliveries")
assignedDeliveries Delivery[] @relation("DriverDeliveries")
deliveryEvents     DeliveryEvent[]

driverLocations DriverLocation[]
  notifications Notification[]
  vehicleAssignments DriverVehicleAssignment[]
  qualifications DriverQualification[] @relation("DriverQualifications")
  verifiedQualifications DriverQualification[] @relation("QualificationVerifier")
  shifts DriverShift[]

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

@@index([role])
@@index([status])
@@map("users")
}

model RefreshToken {
id                  String    @id @default(uuid()) @db.Uuid
tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
userId              String    @map("user_id") @db.Uuid
expiresAt           DateTime  @map("expires_at")
revokedAt           DateTime? @map("revoked_at")
replacedByTokenHash String?   @map("replaced_by_token_hash") @db.VarChar(64)

createdAt DateTime @default(now()) @map("created_at")

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId])
@@index([expiresAt])
@@map("refresh_tokens")
}

model AuthToken {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  purpose       AuthTokenPurpose
  tokenHash     String           @unique @map("token_hash") @db.VarChar(64)
  expiresAt     DateTime         @map("expires_at")
  consumedAt    DateTime?        @map("consumed_at")
  invalidatedAt DateTime?        @map("invalidated_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([purpose, expiresAt])
  @@map("auth_tokens")
}

model AuditLog {
  id           String       @id @default(uuid()) @db.Uuid
  actorUserId  String?      @map("actor_user_id") @db.Uuid
  actorRole    UserRole?    @map("actor_role")
  action       String       @db.VarChar(100)
  resourceType String       @map("resource_type") @db.VarChar(50)
  resourceId   String?      @map("resource_id") @db.VarChar(100)
  outcome      AuditOutcome
  requestId    String?      @map("request_id") @db.VarChar(100)
  ipAddress    String?      @map("ip_address") @db.VarChar(45)
  metadata     Json?        @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt, id])
  @@index([action, createdAt, id])
  @@index([resourceType, resourceId, createdAt, id])
  @@index([outcome, createdAt, id])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @map("actor_id") @db.Uuid
  operation          String   @db.VarChar(100)
  keyHash            String   @map("key_hash") @db.VarChar(64)
  requestFingerprint String   @map("request_fingerprint") @db.VarChar(64)
  resourceType       String   @map("resource_type") @db.VarChar(50)
  resourceId         String   @map("resource_id") @db.VarChar(100)
  responseStatus     Int      @map("response_status")
  createdAt          DateTime @default(now()) @map("created_at")
  expiresAt          DateTime @map("expires_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, operation, keyHash])
  @@index([expiresAt])
  @@index([actorId, createdAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id            String         @id @default(uuid()) @db.Uuid
  eventType     OutboxEventType @map("event_type")
  dedupeKey     String         @unique @map("dedupe_key") @db.VarChar(180)
  payload       Json?          @db.JsonB
  status        OutboxStatus   @default(PENDING)
  attempts      Int            @default(0)
  availableAt   DateTime       @default(now()) @map("available_at")
  lockedAt      DateTime?      @map("locked_at")
  processedAt   DateTime?      @map("processed_at")
  failedAt      DateTime?      @map("failed_at")
  lastErrorCode String?        @map("last_error_code") @db.VarChar(100)
  requestId     String?        @map("request_id") @db.VarChar(100)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([createdAt])
  @@map("outbox_events")
}

model Delivery {
id           String         @id @default(uuid()) @db.Uuid
trackingCode String         @unique @map("tracking_code") @db.VarChar(30)

customerId String         @map("customer_id") @db.Uuid
driverId   String?        @map("driver_id") @db.Uuid

status DeliveryStatus @default(PENDING)

recipientName  String @map("recipient_name") @db.VarChar(150)
recipientPhone String @map("recipient_phone") @db.VarChar(30)

pickupAddress   String   @map("pickup_address") @db.VarChar(500)
pickupLatitude  Decimal? @map("pickup_latitude") @db.Decimal(10, 7)
pickupLongitude Decimal? @map("pickup_longitude") @db.Decimal(10, 7)

deliveryAddress   String   @map("delivery_address") @db.VarChar(500)
deliveryLatitude  Decimal? @map("delivery_latitude") @db.Decimal(10, 7)
deliveryLongitude Decimal? @map("delivery_longitude") @db.Decimal(10, 7)

packageDescription String?  @map("package_description") @db.Text
packageWeight      Decimal? @map("package_weight") @db.Decimal(10, 2)

requiredVehicleType       VehicleType? @map("required_vehicle_type")
minimumPayloadKg          Decimal?     @map("minimum_payload_kg") @db.Decimal(10, 2)
minimumVolumeCubicMeters  Decimal?     @map("minimum_volume_cubic_meters") @db.Decimal(10, 3)
requiresRefrigeratedTransport Boolean  @default(false) @map("requires_refrigerated_transport")
requiredQualifications    String[]     @default([]) @map("required_qualifications")
vehicleId                 String?      @map("vehicle_id") @db.Uuid

notes String? @db.Text

assignedAt  DateTime? @map("assigned_at")
pickedUpAt  DateTime? @map("picked_up_at")
deliveredAt DateTime? @map("delivered_at")

customer User  @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Restrict)
driver   User? @relation("DriverDeliveries", fields: [driverId], references: [id], onDelete: SetNull)
vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

events          DeliveryEvent[]
driverLocations DriverLocation[]
  notifications Notification[]

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

@@index([customerId])
@@index([driverId])
@@index([vehicleId])
@@index([status])
@@index([createdAt])
@@map("deliveries")
}

model Vehicle {
  id                       String        @id @default(uuid()) @db.Uuid
  registrationIdentifier   String        @unique @map("registration_identifier") @db.VarChar(32)
  type                     VehicleType
  maximumPayloadKg         Decimal       @map("maximum_payload_kg") @db.Decimal(10, 2)
  maximumVolumeCubicMeters Decimal?      @map("maximum_volume_cubic_meters") @db.Decimal(10, 3)
  refrigerated             Boolean       @default(false)
  status                   VehicleStatus @default(ACTIVE)
  description              String?       @db.VarChar(250)
  assignments              DriverVehicleAssignment[]
  deliveries               Delivery[]
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([status, maximumPayloadKg])
  @@map("vehicles")
}

model DriverVehicleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  vehicleId String    @map("vehicle_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  driver    User      @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([driverId, endedAt, startedAt])
  @@index([vehicleId, endedAt, startedAt])
  @@map("driver_vehicle_assignments")
}

model DriverQualification {
  id                  String                          @id @default(uuid()) @db.Uuid
  driverId            String                          @map("driver_id") @db.Uuid
  qualificationType   String                          @map("qualification_type") @db.VarChar(60)
  licenseCategory     String?                         @map("license_category") @db.VarChar(20)
  issuedAt            DateTime?                       @map("issued_at") @db.Timestamptz(3)
  expiresAt           DateTime?                       @map("expires_at") @db.Timestamptz(3)
  verificationStatus  QualificationVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt          DateTime?                       @map("verified_at") @db.Timestamptz(3)
  verifiedById        String?                         @map("verified_by_id") @db.Uuid
  notes               String?                         @db.VarChar(500)
  driver              User                            @relation("DriverQualifications", fields: [driverId], references: [id], onDelete: Cascade)
  verifiedBy          User?                           @relation("QualificationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([driverId, qualificationType, verificationStatus])
  @@index([verificationStatus, expiresAt])
  @@map("driver_qualifications")
}

model DriverShift {
  id        String            @id @default(uuid()) @db.Uuid
  driverId  String            @map("driver_id") @db.Uuid
  startsAt  DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime          @map("ends_at") @db.Timestamptz(3)
  timezone  String            @db.VarChar(64)
  status    DriverShiftStatus @default(SCHEDULED)
  driver    User              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([driverId, status, startsAt, endsAt])
  @@map("driver_shifts")
}

model DeliveryEvent {
id         String         @id @default(uuid()) @db.Uuid
deliveryId String         @map("delivery_id") @db.Uuid
actorId    String?        @map("actor_id") @db.Uuid

status      DeliveryStatus
description String?        @db.Text

delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

createdAt DateTime @default(now()) @map("created_at")

@@index([deliveryId])
@@index([actorId])
@@index([createdAt])
@@map("delivery_events")
}

model DriverLocation {
id         String   @id @default(uuid()) @db.Uuid
driverId   String   @map("driver_id") @db.Uuid
deliveryId String?  @map("delivery_id") @db.Uuid

latitude  Float
longitude Float
accuracy  Float?

recordedAt DateTime @default(now()) @map("recorded_at")

driver User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

@@index([driverId, recordedAt])
@@index([deliveryId, recordedAt])
@@index([recordedAt])
@@map("driver_locations")
}


model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  deliveryId String?          @map("delivery_id") @db.Uuid

  type       NotificationType
  title      String           @db.VarChar(150)
  message    String           @db.Text

  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@index([deliveryId])
  @@map("notifications")
}
