generator client {
provider = "prisma-client"
output   = "../src/generated/prisma"
}

datasource db {
provider = "postgresql"
}

enum UserRole {
SUPER_ADMIN
ADMIN
DISPATCHER
DRIVER
CUSTOMER
}

enum UserStatus {
ACTIVE
INACTIVE
SUSPENDED
PENDING_VERIFICATION
}

enum DeliveryStatus {
PENDING
ASSIGNED
PICKED_UP
IN_TRANSIT
DELIVERED
CANCELLED
}

model User {
id           String     @id @default(uuid()) @db.Uuid
firstName    String     @map("first_name") @db.VarChar(100)
lastName     String     @map("last_name") @db.VarChar(100)
email        String     @unique @db.VarChar(255)
passwordHash String     @map("password_hash") @db.VarChar(255)
phone        String?    @unique @db.VarChar(30)
role         UserRole   @default(CUSTOMER)
status       UserStatus @default(ACTIVE)

emailVerifiedAt DateTime? @map("email_verified_at")
lastLoginAt     DateTime? @map("last_login_at")

refreshTokens RefreshToken[]

customerDeliveries Delivery[] @relation("CustomerDeliveries")
assignedDeliveries Delivery[] @relation("DriverDeliveries")
deliveryEvents     DeliveryEvent[]

driverLocations DriverLocation[]

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

@@index([role])
@@index([status])
@@map("users")
}

model RefreshToken {
id                  String    @id @default(uuid()) @db.Uuid
tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
userId              String    @map("user_id") @db.Uuid
expiresAt           DateTime  @map("expires_at")
revokedAt           DateTime? @map("revoked_at")
replacedByTokenHash String?   @map("replaced_by_token_hash") @db.VarChar(64)

createdAt DateTime @default(now()) @map("created_at")

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId])
@@index([expiresAt])
@@map("refresh_tokens")
}

model Delivery {
id           String         @id @default(uuid()) @db.Uuid
trackingCode String         @unique @map("tracking_code") @db.VarChar(30)

customerId String         @map("customer_id") @db.Uuid
driverId   String?        @map("driver_id") @db.Uuid

status DeliveryStatus @default(PENDING)

recipientName  String @map("recipient_name") @db.VarChar(150)
recipientPhone String @map("recipient_phone") @db.VarChar(30)

pickupAddress   String   @map("pickup_address") @db.VarChar(500)
pickupLatitude  Decimal? @map("pickup_latitude") @db.Decimal(10, 7)
pickupLongitude Decimal? @map("pickup_longitude") @db.Decimal(10, 7)

deliveryAddress   String   @map("delivery_address") @db.VarChar(500)
deliveryLatitude  Decimal? @map("delivery_latitude") @db.Decimal(10, 7)
deliveryLongitude Decimal? @map("delivery_longitude") @db.Decimal(10, 7)

packageDescription String?  @map("package_description") @db.Text
packageWeight      Decimal? @map("package_weight") @db.Decimal(10, 2)

notes String? @db.Text

assignedAt  DateTime? @map("assigned_at")
pickedUpAt  DateTime? @map("picked_up_at")
deliveredAt DateTime? @map("delivered_at")

customer User  @relation("CustomerDeliveries", fields: [customerId], references: [id], onDelete: Restrict)
driver   User? @relation("DriverDeliveries", fields: [driverId], references: [id], onDelete: SetNull)

events          DeliveryEvent[]
driverLocations DriverLocation[]

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @updatedAt @map("updated_at")

@@index([customerId])
@@index([driverId])
@@index([status])
@@index([createdAt])
@@map("deliveries")
}

model DeliveryEvent {
id         String         @id @default(uuid()) @db.Uuid
deliveryId String         @map("delivery_id") @db.Uuid
actorId    String?        @map("actor_id") @db.Uuid

status      DeliveryStatus
description String?        @db.Text

delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

createdAt DateTime @default(now()) @map("created_at")

@@index([deliveryId])
@@index([actorId])
@@index([createdAt])
@@map("delivery_events")
}

model DriverLocation {
id         String   @id @default(uuid()) @db.Uuid
driverId   String   @map("driver_id") @db.Uuid
deliveryId String?  @map("delivery_id") @db.Uuid

latitude  Float
longitude Float
accuracy  Float?

recordedAt DateTime @default(now()) @map("recorded_at")

driver User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

@@index([driverId, recordedAt])
@@index([deliveryId, recordedAt])
@@map("driver_locations")
}
