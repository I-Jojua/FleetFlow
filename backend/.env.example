# Local development can use the safe defaults in src/config/env.ts.
# Set TRUST_PROXY_HOPS only to the number of trusted reverse proxies in front
# of the app (leave at 0 when connecting directly).
# TRUST_PROXY_HOPS=0
# Comma-separated explicit frontend origins; production must set this.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Production must explicitly configure Redis for shared rate limiting.
# REDIS_URL=rediss://<user>:<password>@<host>:6379
# Graceful shutdown waits this many milliseconds for in-flight HTTP requests.
# GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
# API docs are enabled by default outside production; production defaults off.
# To enable them in production, set API_DOCS_ENABLED=true and a 32+ character token.
# API_DOCS_ENABLED=false
# API_DOCS_ACCESS_TOKEN=<long-random-token>
# Metrics are disabled unless a dedicated 32+ character bearer token is configured.
# METRICS_ACCESS_TOKEN=<long-random-token>
# Production must explicitly provide DATABASE_URL and two distinct JWT secrets
# (at least 32 characters each). Never commit actual credentials.
# NODE_ENV=production
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# JWT_ACCESS_SECRET=<random-secret-at-least-32-characters>
# JWT_REFRESH_SECRET=<different-random-secret-at-least-32-characters>
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
